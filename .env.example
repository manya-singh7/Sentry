# =============================================================================
# Sentry / diagnos-ai Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini API Keys
# -----------------------------------------------------------------------------
# Primary Gemini API key (required to run LLM operations)
GEMINI_API_KEY=your_gemini_api_key_here

# Backup Gemini API key (optional; used for automatic failover on 429 quota limit)
GEMINI_API_KEY_BACKUP=your_backup_gemini_api_key_here

# -----------------------------------------------------------------------------
# Response Formatting & Feature Flags
# -----------------------------------------------------------------------------
# Response schema format: "flat" (default) or "appendix_b"
RESPONSE_SHAPE=flat

# Toggles parallel query variation generation on cache miss (default: false)
ENABLE_QUERY_VARIATIONS=false

# Toggles self-critique rescoring pass with latency budget guard (default: false)
ENABLE_SELF_CRITIQUE=false

# -----------------------------------------------------------------------------
# Semantic Cache Configuration
# -----------------------------------------------------------------------------
# Exposes the /v1/cache/entries inspection endpoint when set to true (default: false)
CACHE_DEBUG=false

# Cosine similarity threshold for semantic cache hits (default: 0.75)
CACHE_SIM_THRESHOLD=0.75

# Maximum number of entries retained in the semantic cache (default: 2000)
CACHE_MAX_ENTRIES=2000

# Custom directory for FastEmbed embedding model weights (optional)
# FASTEMBED_CACHE_PATH=
